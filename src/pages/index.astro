---

/**
 * Home.
 *
 * I progetti in evidenza sono quelli con `featured: true`, ma se sono meno di
 * tre si ripiega sui più recenti: una home con una sola scheda sembra un sito
 * abbandonato, e all'inizio nessuno avrà marcato niente come in evidenza.
 *
 * Attrezzature e principi sono scritti qui e non nei contenuti: cambiano una
 * volta l'anno e non meritano una collezione. I tre principi in home sono
 * l'estratto della pagina /valori/, che a sua volta riassume i documenti di
 * governance: la fonte è quella, non questo file.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../site.config';
import { getProjects, getPosts } from '../lib/content';

const projects = await getProjects();
const posts = await getPosts();

// In evidenza se marcati tali, altrimenti i più recenti: la home non è mai vuota.
const featured = projects.filter((p) => p.data.featured);
const showcase = (featured.length >= 3 ? featured : projects).slice(0, 6);
const latestPosts = posts.slice(0, 3);

// I numeri si mostrano solo quando dicono qualcosa: «1 progetto, 1 maker»
// racconta un posto vuoto meglio di quanto farebbe il silenzio.
const STATS_MIN_PROJECTS = 5;
const stats = projects.length < STATS_MIN_PROJECTS ? [] : [
  { n: projects.length, label: 'progetti documentati' },
  { n: new Set(projects.flatMap((p) => p.data.authors)).size, label: 'maker coinvolti' },
  { n: new Set(projects.flatMap((p) => p.data.tags)).size, label: 'ambiti diversi' },
];

/**
 * Lo slogan dell'hero: una domanda e la sua risposta, estratte insieme.
 *
 * Ogni voce è [attacco, evidenza, coda, risposta]. L'evidenza è l'unica cosa
 * in arancio del titolo, e prende il sintagma intero — "gli attrezzi", non
 * "attrezzi"; "a saldare", non "saldare" — perché un articolo o una
 * preposizione lasciati fuori spezzano la cosa a metà e l'occhio inciampa.
 * La coda è quasi sempre "?" ma resta scrivibile: serve a chi ha l'evidenza in
 * mezzo alla frase e non in fondo. La risposta cambia con la domanda: tenerla
 * fissa costringeva a piegare le domande a una chiusura sola, e alcune
 * suonavano finte.
 *
 * Si dice "ti servono", non "ti mancano": in italiano "mi manchi" è affettivo,
 * e "ti manca l'officina?" si legge come se l'officina l'avessi persa.
 *
 * Ogni domanda nomina una cosa che il lab dà davvero — gli attrezzi, lo
 * spazio, chi insegna, il permesso di sbagliare. Non se ne aggiungono di
 * ironiche ("ti serve tempo?", "ti serve voglia?"): quelle il lab non le
 * risolve, e una promessa falsa nell'hero si paga alla prima visita.
 *
 * Restano corte, e il limite lo fa rispettare la build: vedi i controlli
 * subito sotto l'elenco.
 *
 * Quale si vede la sceglie il visitatore senza saperlo: uno script in linea ne
 * estrae una a caso a ogni caricamento (vedi in fondo all'hero). Senza
 * JavaScript, e per gli screen reader che leggono l'HTML servito, resta la
 * prima — che è anche `SITE.tagline`, cioè il <title> della home.
 *
 * L'ordine quindi conta solo per la prima. Aggiungerne è gratis: più sono,
 * meno capita di rivedere la stessa due volte di fila.
 */
const slogan = [
  ['Ti servono ', 'gli attrezzi', '?', 'Qui ci sono.'],
  ['Ti serve ', 'lo spazio', '?', 'Eccolo.'],
  ['Non sai ', 'da dove partire', '?', 'Si parte qui.'],
  ['Vuoi imparare ', 'a saldare', '?', 'Ti insegniamo.'],
  ['Hai ', "un'idea", ' ferma?', 'Qui riparte.'],
  ['Vuoi provare ', 'la stampa 3D', '?', 'Si prova qui.'],
  ['Hai paura ', 'di sbagliare', '?', 'Sbagliamo tutti.'],
  ['Mai usato ', 'un saldatore', '?', 'Vieni da noi.'],
  ['Cerchi ', 'un hobby', '?', 'Qui lo trovi.'],
  ['Ti senti ', 'imbranato', '?', 'Qui non lo sei.'],
  ['Non sai cos\'è ', 'un PCB', '?', 'Scoprilo.'],
  ['Non sai cos\'è ', 'Arduino', '?', 'Scoprilo.']
];

/**
 * Il limite non è un consiglio: se una frase sfora, la build si ferma. È lo
 * stesso patto del resto del sito — meglio rossa in CI che storta in pagina.
 *
 * I due numeri non sono uguali, e non per caso:
 * - la domanda è un tetto di LARGHEZZA. A corpo grande, oltre i 26 caratteri
 *   va a capo sul telefono e diventa tre righe invece di due;
 * - la risposta è un tetto di RITMO. Deve arrivare secca e restare nettamente
 *   più corta della domanda: "Qui si sbaglia tutti." (21) stava dentro
 *   qualsiasi schermo, ma lunga quanto la domanda si mangiava la battuta.
 */
const MAX_DOMANDA = 26;
const MAX_RISPOSTA = 18;
for (const [attacco, evidenza, coda, risposta] of slogan) {
  const domanda = attacco + evidenza + coda;
  if (domanda.length > MAX_DOMANDA) {
    throw new Error(`[slogan] la domanda «${domanda}» è di ${domanda.length} caratteri, il massimo è ${MAX_DOMANDA}`);
  }
  if (risposta.length > MAX_RISPOSTA) {
    throw new Error(`[slogan] la risposta «${risposta}» è di ${risposta.length} caratteri, il massimo è ${MAX_RISPOSTA}`);
  }
}

const attrezzature = [
  { icon: 'printer', title: 'Stampa 3D', text: 'Stampanti a filamento, con bobine condivise e slicer già configurati.' },
  { icon: 'circuit-board', title: 'Banco elettronica', text: 'Stazione saldante, alimentatori e un cassetto di componenti.' },
  { icon: 'hammer', title: 'Falegnameria', text: 'Utensili a mano e macchine per il legno, con chi ti insegna a usarle.' },
];

const principi = [
  {
    n: '01',
    title: 'Do-ocracy',
    text: 'Qui non si aspetta il permesso. Vuoi fare qualcosa? Falla. Chi fa il lavoro decide su quel lavoro.',
  },
  {
    n: '02',
    title: 'Bene comune',
    text: 'Siamo un makerspace comunale, parte dei Beni Comuni di Gorgonzola, aperto a tutti i cittadini.',
  },
  {
    n: '03',
    title: 'Si impara sbagliando',
    text: 'Qui si crea, si sbaglia, si condivide, si collabora, si ricerca, si sperimenta. Nessuno nasce capace.',
  },
];
---

<BaseLayout bleed>
  <!-- HERO ------------------------------------------------------- -->
  <section class="hero wrap">
    <p class="eyebrow">{SITE.kicker}</p>
    <h1 class="shout">
      {/* Su una riga sola: fra due tag in linea un a capo nel sorgente diventa
          uno spazio a video, e finirebbe davanti all'evidenza e alla coda. */}
      <span><span id="slogan-attacco">{slogan[0][0]}</span><span class="evidenza" id="slogan-evidenza">{slogan[0][1]}</span><span id="slogan-coda">{slogan[0][2]}</span></span>
      <span id="slogan-risposta">{slogan[0][3]}</span>
    </h1>
    {/*
      Lo script sta qui, subito sotto il titolo, e NON è un modulo: così è
      sincrono e la sostituzione avviene prima che il browser disegni: il
      visitatore non vede la frase cambiare sotto gli occhi. `define:vars` lo
      rende in linea e ci porta dentro l'elenco, che resta scritto una volta
      sola qui sopra, già chiuso da Astro in una funzione sua: niente variabili
      globali. La CSP ammette gli script in linea (`public/_headers`).
    */}
    <script is:inline define:vars={{ slogan }}>
      const scelta = slogan[Math.floor(Math.random() * slogan.length)];
      ['attacco', 'evidenza', 'coda', 'risposta'].forEach(function (pezzo, i) {
        document.getElementById('slogan-' + pezzo).textContent = scelta[i];
      });
    </script>
    <p class="lead">{SITE.description}</p>

    <div class="cta">
      <a class="btn btn-primary" href="/progetti/">Guarda i progetti →</a>
      <a class="btn btn-ghost" href="/contatti/">Come arrivare</a>
    </div>

    {stats.length > 0 && (
      <dl class="stats">
        {stats.map((s) => (
          <div>
            <dt class="shout">{s.n}</dt>
            <dd class="mono">{s.label}</dd>
          </div>
        ))}
      </dl>
    )}
  </section>

  <!-- PRINCIPI ---------------------------------------------------- -->
  <section class="band band-paper">
    <div class="wrap">
      <header class="block-head">
        <div>
          <p class="eyebrow">Come si sta qui</p>
          <h2 class="shout">Tre cose in cui crediamo</h2>
        </div>
        <a class="more" href="/valori/">Tutti i valori →</a>
      </header>
      <ul class="principi">
        {principi.map((p) => (
          <li>
            <p class="num mono">{p.n}</p>
            <h2 class="shout">{p.title}</h2>
            <p class="body">{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PROGETTI ---------------------------------------------------- -->
  <section class="wrap block">
    <header class="block-head">
      <div>
        <p class="eyebrow">Dal banco di lavoro</p>
        <h2 class="shout">Cosa costruiamo</h2>
      </div>
      <a class="more" href="/progetti/">Tutti i progetti →</a>
    </header>

    {showcase.length === 0 ? (
      <p class="empty">
        Il primo progetto manca ancora. <a href="/contribuire/">Ecco come pubblicarlo.</a>
      </p>
    ) : (
      <ul class="grid">
        {showcase.map((entry, i) => <li><ProjectCard entry={entry} index={i} /></li>)}
      </ul>
    )}
  </section>

  <!-- ATTREZZATURE ------------------------------------------------ -->
  <section class="band band-blue on-blue">
    <div class="wrap">
      <header class="block-head">
        <div>
          <p class="eyebrow on-dark">Lo spazio</p>
          <h2 class="shout">Cosa trovi in officina</h2>
        </div>
        <a class="more" href="/spazio/">Orari e regole →</a>
      </header>

      <ul class="tools">
        {attrezzature.map((t) => (
          <li>
            <span class="ico"><Icon name={t.icon} size={26} /></span>
            <h3 class="shout">{t.title}</h3>
            <p>{t.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- BLOG -------------------------------------------------------- -->
  {latestPosts.length > 0 && (
    <section class="wrap block">
      <header class="block-head">
        <div>
          <p class="eyebrow">Diario di bordo</p>
          <h2 class="shout">Ultimi articoli</h2>
        </div>
        <a class="more" href="/blog/">Tutto il blog →</a>
      </header>

      <ul class="posts">
        {latestPosts.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`}>
              <time class="mono" datetime={p.data.date.toISOString()}>
                {p.data.date.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
              <h3 class="shout">{p.data.title}</h3>
              <p>{p.data.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- CITAZIONE --------------------------------------------------- -->
  <blockquote class="quote shout">
    <span class="mark">«</span>Vuoi fare qualcosa? <b>Fallo e basta.</b><span class="mark">»</span>
    <cite class="mono">Il principio della do-ocracy</cite>
  </blockquote>

  <!-- CONTRIBUISCI ------------------------------------------------ -->
  <section class="wrap">
    <div class="join">
      <div>
        <h2 class="shout">Hai costruito qualcosa? Raccontalo.</h2>
        <p>
          I progetti di questo sito li scrivono i maker, non un redattore. Tu porti
          un file di testo e le foto: impaginazione, ottimizzazione delle immagini
          e pagina del progetto le fa il sito.
        </p>
      </div>
      <a class="btn btn-primary" href="/contribuire/">Come si pubblica →</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero { padding-block: var(--s-9) var(--s-8); }
  /* `.shout` sta a 0.95 di interlinea, che sotto l'1 fa uscire gli accenti
     delle maiuscole (Ù di PIÙ, È di C'È) sopra l'altezza delle lettere: finivano
     addosso alla riga precedente, e si vedeva o no a seconda di cosa capitava
     sopra. 1.05 è il minimo che li fa stare, e su due righe non si nota. */
  h1 { font-size: var(--fz-fluid-6xl); margin-top: var(--s-5); line-height: 1.05; }
  /* Figli DIRETTI: sono le due righe del titolo. Gli span dentro la domanda
     restano in linea senza doverlo ridichiarare. */
  h1 > span { display: block; }
  /* L'unico arancio del titolo è la cosa che ti serve: è lì che deve andare
     l'occhio, non sulla risposta. */
  h1 .evidenza { color: var(--gl-orange-600); }

  .hero .lead { max-width: 46ch; margin-top: var(--s-6); font-size: var(--fz-lg); }

  .cta { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }

  .stats { display: flex; flex-wrap: wrap; gap: var(--s-8); margin-top: var(--s-8); }
  .stats dt { font-size: var(--fz-3xl); color: var(--gl-blue-600); }
  .stats dd { margin: 0; color: var(--fg-3); text-transform: uppercase; letter-spacing: var(--tr-shout); font-size: var(--fz-xs); }

  /* PRINCIPI */
  .principi { list-style: none; padding: 0; display: grid; gap: var(--s-4); grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); }
  .principi li {
    background: var(--gl-paper); padding: var(--s-5);
    border: var(--bw-2) solid var(--gl-ink); border-radius: var(--r-lg);
    box-shadow: var(--sh-card);
  }
  .num { color: var(--gl-orange-800); font-weight: 700; letter-spacing: 0.1em; }
  .principi h2 { font-size: var(--fz-xl); margin-block: var(--s-2) var(--s-2); }
  .principi .body { color: var(--fg-2); font-size: var(--fz-sm); }

  /* BLOCCHI */
  .block { padding-block: var(--s-9); }
  .block-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--s-4); margin-bottom: var(--s-6); }
  .block-head h2 { font-size: var(--fz-fluid-3xl); margin-top: var(--s-2); }
  /* su blu serve il chiaro: vedi nota in global.css */
  .eyebrow.on-dark { color: var(--gl-blue-050); }
  .more { font-weight: 700; white-space: nowrap; text-decoration: none; }
  .more:hover { text-decoration: underline; }
  .empty { color: var(--fg-2); }

  .grid { list-style: none; padding: 0; display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); }

  /* ATTREZZATURE */
  /* auto-fit e non auto-fill: con tre sole schede le colonne vuote lascerebbero
     un buco sulla banda blu invece di distribuire lo spazio. */
  .tools { list-style: none; padding: 0; display: grid; gap: var(--s-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  .tools li {
    background: var(--gl-paper); color: var(--fg-1); padding: var(--s-5);
    border: var(--bw-2) solid var(--gl-ink); border-radius: var(--r-lg);
    box-shadow: var(--sh-card-lg);
  }
  .ico { color: var(--gl-orange-700); display: block; margin-bottom: var(--s-3); }
  .tools h3 { font-size: var(--fz-lg); margin-bottom: var(--s-2); }
  .tools p { font-size: var(--fz-sm); color: var(--fg-2); }

  /* BLOG */
  .posts { list-style: none; padding: 0; display: grid; gap: var(--s-4); grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); }
  .posts a {
    display: block; height: 100%; padding: var(--s-5);
    background: var(--gl-paper); color: inherit; text-decoration: none;
    border: var(--bw-2) solid var(--gl-ink); border-radius: var(--r-lg);
    box-shadow: var(--sh-card);
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
  .posts a:hover { background: var(--gl-orange-100); transform: translate(2px, 2px); box-shadow: 0 0 0 0 var(--gl-ink); }
  .posts time { color: var(--fg-3); text-transform: uppercase; letter-spacing: 0.05em; }
  .posts h3 { font-size: var(--fz-lg); margin-block: var(--s-2) var(--s-2); }
  .posts p { color: var(--fg-2); font-size: var(--fz-sm); }

  /* CITAZIONE — regola spessa sopra e sotto, come una scritta in bacheca */
  .quote {
    margin: 0; padding: var(--s-8) var(--pad); text-align: center;
    font-size: var(--fz-fluid-3xl); color: var(--fg-1);
    border-block: var(--bw-4) solid var(--gl-ink);
    /* carta piena, non paper-2: l'arancio pieno regge 3:1 solo su questo fondo */
    background: var(--bg-1);
  }
  .quote b { color: var(--gl-orange-600); font-weight: inherit; }
  .mark { color: var(--gl-orange-600); }
  .quote cite {
    display: block; margin-top: var(--s-4); font-style: normal;
    font-size: var(--fz-xs); text-transform: uppercase; letter-spacing: var(--tr-shout); color: var(--fg-3);
  }

  /* CONTRIBUISCI */
  .join {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: var(--s-6); margin-block: var(--s-9);
    padding: var(--s-7) var(--s-6);
    background: var(--gl-orange-600); color: var(--fg-on-orange);
    border: var(--bw-2) solid var(--gl-ink); border-radius: var(--r-lg);
    box-shadow: var(--sh-card-lg);
  }
  .join h2 { font-size: var(--fz-fluid-2xl); }
  .join p { margin-top: var(--s-3); max-width: 52ch; }
  .join .btn { background: var(--gl-paper); }
  .join .btn:hover { background: var(--gl-white); }
</style>
