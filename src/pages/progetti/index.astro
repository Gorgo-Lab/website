---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, tagCounts } from '../../lib/content';

const projects = await getProjects();
const tags = tagCounts(projects);
---

<BaseLayout
  title="Progetti"
  description="Tutto quello che è stato progettato, costruito e documentato al Gorgo Lab."
>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">{projects.length} progetti documentati</p>
      <h1 class="shout">Cosa costruiamo</h1>
      <p class="lead">
        Ogni scheda è un progetto documentato da chi l'ha realizzato: schemi, file
        sorgente e passi falsi compresi.
      </p>
    </header>

    <nav class="filters" aria-label="Filtra per tag">
      <a class="tag" data-on="true" href="/progetti/">tutti <span class="count">{projects.length}</span></a>
      {tags.map(([t, n]) => (
        <a class="tag" href={`/progetti/tag/${t}/`}>{t} <span class="count">{n}</span></a>
      ))}
    </nav>

    {projects.length === 0 ? (
      <p class="empty">
        Ancora nessun progetto pubblicato. <a href="/contribuire/">Fallo e basta.</a>
      </p>
    ) : (
      <ul class="grid">
        {projects.map((entry, i) => (
          <li><ProjectCard entry={entry} index={i} /></li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>

<style>
  .page-head { max-width: 44ch; margin-bottom: var(--s-6); }
  h1 { font-size: var(--fz-fluid-4xl); margin-block: var(--s-3); }
  .filters { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-bottom: var(--s-7); }
  .grid { list-style: none; padding: 0; display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); }
  .empty { color: var(--fg-2); padding-block: var(--s-8); }
</style>
