---

/**
 * Galleria di immagini di un progetto, costruita dal campo `gallery` del
 * frontmatter (quindi già validato: ogni immagine esiste davvero).
 *
 * Le proporzioni stanno sul riquadro e non sull'immagine: così le caselle
 * restano tutte identiche qualunque formato abbiano le foto dentro, che
 * vengono ritagliate al centro.
 *
 * Il collegamento punta al file ottimizzato: dà l'ingrandimento a schermo
 * intero senza tirarsi dietro una libreria per le gallerie.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  alts?: string[];
  title?: string;
}

const { images, alts = [], title = 'Galleria' } = Astro.props;
---

<section class="gallery" aria-labelledby="galleria">
  <h2 id="galleria" class="shout">{title}</h2>
  <ul>
    {images.map((img, i) => (
      <li>
        {/* Il link al file ottimizzato dà lo zoom senza tirarsi dietro una lightbox */}
        <a href={img.src} target="_blank" rel="noopener">
          <Image
            src={img}
            alt={alts[i] ?? ''}
            width={640}
            height={480}
            widths={[320, 640, 960]}
            sizes="(max-width: 46rem) 47vw, 18rem"
            loading="lazy"
          />
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .gallery { margin-top: var(--s-8); max-width: var(--wrap-text); }
  h2 {
    font-size: var(--fz-fluid-2xl); color: var(--fg-1);
    padding-top: var(--s-5); border-top: var(--bw-4) solid var(--gl-ink);
    margin-bottom: var(--s-4);
  }
  ul {
    list-style: none; padding: 0; display: grid; gap: var(--s-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
  }
  a {
    display: block; overflow: hidden;
    /* Le proporzioni stanno sul riquadro, non sull'immagine: così tutte le
       caselle sono identiche qualunque formato abbiano le foto dentro. */
    aspect-ratio: 4 / 3;
    border: var(--bw-2) solid var(--gl-ink); border-radius: var(--r-md);
    box-shadow: var(--sh-card);
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  a:hover { transform: translate(2px, 2px); box-shadow: 0 0 0 0 var(--gl-ink); }
  a :global(img) { width: 100%; height: 100%; object-fit: cover; margin: 0; }
</style>
